# Inbox that receives contact-form messages.
# Use the client's personal Gmail. This is separate from the Gmail
# used to sign in to Resend, and from any address shown on the site.
CONTACT_TO_EMAIL=

# Verified sender used as the From address.
# Planned address: forms@notify.pranda.global
# Verify notify.pranda.global in Resend before live delivery.
CONTACT_FROM_EMAIL=

# Resend sending key. Server-side only. Never expose this to the browser.
RESEND_API_KEY=

# Optional. The Book a call button appears only when this is an http(s) URL.
BOOKING_URL=

# Optional. The privacy-policy link appears only when this is an http(s) URL.
PRIVACY_POLICY_URL=
