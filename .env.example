# Inbox that receives contact-form messages.
# This is separate from the public email address shown in the footer.
CONTACT_TO_EMAIL=

# Verified sender used as the From address. See README for the
# verification step required by the provider you choose.
CONTACT_FROM_EMAIL=

# "resend" or "smtp". Leave empty until a provider is chosen.
EMAIL_PROVIDER=

# Credential for Resend. Required only when EMAIL_PROVIDER=resend.
RESEND_API_KEY=

# Credential and server for SMTP. Required only when EMAIL_PROVIDER=smtp.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Optional. The Book a call button appears only when this is an http(s) URL.
BOOKING_URL=

# Optional. The privacy-policy link appears only when this is an http(s) URL.
PRIVACY_POLICY_URL=
